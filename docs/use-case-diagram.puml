@startuml UniChat_UseCase
title Sơ đồ Use Case tổng quát - UniChat

left to right direction

skinparam dpi 160
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam linetype ortho
skinparam roundcorner 22
skinparam nodesep 45
skinparam ranksep 32

skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam titleFontName Arial
skinparam titleFontSize 20
skinparam titleFontStyle bold
skinparam titleFontColor #111827

skinparam Actor {
  BackgroundColor #FFFFFF
  BorderColor #111827
  FontColor #111827
}

skinparam Usecase {
  BackgroundColor #DBECFF
  BorderColor #9DB7D6
  FontColor #111827
}

skinparam Rectangle {
  BackgroundColor #FFFFFF
  BorderColor #6B7280
  FontColor #111827
  FontStyle bold
}

skinparam ArrowColor #6B7280
skinparam ArrowThickness 1
skinparam ArrowFontColor #374151
skinparam ArrowFontSize 9

actor "Người dùng" as User
actor "Email/OTP\nService" as EmailOtp
actor "Amazon\nChime" as Chime
actor "AI\nService" as AI

rectangle "HỆ THỐNG UNICHAT" as System {
  usecase "Đăng ký" as Register #FFE9BF
  usecase "Đăng nhập" as Login #D8EFD3

  usecase "Quản lý tài khoản\ncá nhân" as Account #FFE9BF
  usecase "Quên / đặt lại\nmật khẩu" as ResetPassword
  usecase "Đổi mật khẩu" as ChangePassword
  usecase "Khóa tài khoản" as LockAccount
  usecase "Xóa tài khoản" as DeleteAccount

  usecase "Quản lý hồ sơ\ncá nhân" as Profile #FFE9BF
  usecase "Cập nhật thông tin\ncá nhân" as UpdateProfile
  usecase "Cập nhật ảnh đại diện\n/ ảnh bìa" as UpdateAvatar

  usecase "Quản lý phiên đăng nhập\nvà thiết bị" as Sessions #FFE9BF
  usecase "Xem thiết bị\nđăng nhập" as ViewSessions
  usecase "Đăng xuất\nthiết bị" as LogoutDevice
  usecase "Đăng xuất tất cả\nthiết bị" as LogoutAll

  usecase "Cài đặt\nứng dụng" as Settings #FFE9BF
  usecase "Đổi giao diện\n/ ngôn ngữ" as ThemeLanguage
  usecase "Thiết lập quyền\nriêng tư" as Privacy

  usecase "Quản lý\nbạn bè" as Friends #FFE9BF
  usecase "Tìm kiếm\nngười dùng" as SearchUser
  usecase "Gửi lời mời\nkết bạn" as SendFriendRequest
  usecase "Chấp nhận / từ chối\nlời mời" as HandleFriendRequest
  usecase "Hủy kết bạn" as Unfriend
  usecase "Chặn / bỏ chặn\nngười dùng" as BlockUser
  usecase "Đặt biệt danh\n/ bạn thân" as FriendPrefs
  usecase "Xem gợi ý\nkết bạn" as FriendSuggestions

  usecase "Nhắn tin\n1-1" as DirectChat #FFE9BF
  usecase "Nhắn tin\nnhóm" as GroupChat #FFE9BF
  usecase "Gửi tin nhắn\nvăn bản" as SendText
  usecase "Gửi hình ảnh\n/ video / file" as SendFile
  usecase "Gửi vị trí\n/ danh thiếp" as SendSpecial
  usecase "Trả lời tin nhắn" as ReplyMessage
  usecase "Thả cảm xúc" as ReactMessage
  usecase "Ghim / thu hồi\n/ xóa tin nhắn" as MessageActions

  usecase "Quản lý\nnhóm chat" as GroupManagement #FFE9BF
  usecase "Tạo nhóm" as CreateGroup
  usecase "Tham gia nhóm\nbằng link / QR" as JoinGroup
  usecase "Cập nhật thông tin\nnhóm" as UpdateGroup
  usecase "Thêm / xóa\nthành viên" as GroupMembers
  usecase "Phân quyền trưởng nhóm\n/ phó nhóm" as GroupRoles
  usecase "Rời nhóm\n/ giải tán nhóm" as LeaveDisbandGroup

  usecase "Tìm kiếm" as Search #FFE9BF
  usecase "Tìm người dùng" as FindUser
  usecase "Tìm hội thoại" as FindConversation
  usecase "Tìm tin nhắn" as FindMessage
  usecase "Tìm file" as FindFile

  usecase "Quản lý kho media/file/link\ntrong hội thoại" as MediaLibrary #FFE9BF
  usecase "Xem ảnh\n/ video" as ViewMedia
  usecase "Xem file" as ViewFiles
  usecase "Xem liên kết" as ViewLinks

  usecase "Gọi audio / video\n1-1" as DirectCall #FFE9BF
  usecase "Gọi audio / video\nnhóm" as GroupCall #FFE9BF
  usecase "Tạo cuộc gọi" as CreateCall
  usecase "Nhận / tham gia\ncuộc gọi" as JoinCall
  usecase "Từ chối / kết thúc\ncuộc gọi" as EndCall
  usecase "Bật / tắt\nmic, camera" as CallControls
  usecase "Chia sẻ\nmàn hình" as ScreenShare

  usecase "Giao và nộp bài tập\ntrong nhóm" as Assignment #FFE9BF
  usecase "Tạo bài tập" as CreateAssignment
  usecase "Thiết lập deadline" as AssignmentDeadline
  usecase "Quy định loại file\n/ số lượng file" as AssignmentRule
  usecase "Nộp bài\nkèm file" as SubmitAssignment
  usecase "Xóa / thay thế bài nộp\ntrước deadline" as ReplaceSubmission
  usecase "Xem bài nộp" as ViewSubmissions
  usecase "Nhắc hạn\nbài tập" as AssignmentReminder

  usecase "Quản lý\nthông báo" as Notification #FFE9BF
  usecase "Thông báo\ntin nhắn" as MessageNotification
  usecase "Thông báo\ncuộc gọi" as CallNotification
  usecase "Thông báo\nbài tập" as AssignmentNotification

  usecase "Cảnh báo bảo mật\ntài khoản" as SecurityAlerts #FFE9BF
  usecase "Cảnh báo\nđăng nhập lạ" as LoginAlert
  usecase "Xem thông tin\nthiết bị" as DeviceInfo
  usecase "Đăng xuất\nthiết bị lạ" as LogoutUnknownDevice

  usecase "Chat với\nAI chatbot" as AIChat #FFE9BF
  usecase "Mở hội thoại AI" as OpenAI
  usecase "Gửi câu hỏi\ncho AI" as AskAI
  usecase "Gửi file / hình ảnh\ncho AI" as SendAIFile
  usecase "Nhận phản hồi\nAI" as AIResponse
}

' Actor đứng hai bên, chỉ nối vào use case chính để hạn chế rối.
User --> Register
User --> Login
User --> Account
User --> Profile
User --> Sessions
User --> Settings
User --> Friends
User --> DirectChat
User --> GroupChat
User --> GroupManagement
User --> Search
User --> MediaLibrary
User --> DirectCall
User --> GroupCall
User --> Assignment
User --> Notification
User --> SecurityAlerts
User --> AIChat

EmailOtp -left-> Register
EmailOtp -left-> Login
EmailOtp -left-> Account
Chime -left-> DirectCall
Chime -left-> GroupCall
AI -left-> AIChat

' Quan hệ nghiệp vụ cục bộ trong từng cụm chức năng.
Register ..> Login : <<include>>

ResetPassword ..> Account : <<extend>>
ChangePassword ..> Account : <<extend>>
LockAccount ..> Account : <<extend>>
DeleteAccount ..> Account : <<extend>>

UpdateProfile ..> Profile : <<extend>>
UpdateAvatar ..> Profile : <<extend>>

ViewSessions ..> Sessions : <<extend>>
LogoutDevice ..> Sessions : <<extend>>
LogoutAll ..> Sessions : <<extend>>

ThemeLanguage ..> Settings : <<extend>>
Privacy ..> Settings : <<extend>>

SearchUser ..> Friends : <<extend>>
SendFriendRequest ..> Friends : <<extend>>
HandleFriendRequest ..> Friends : <<extend>>
Unfriend ..> Friends : <<extend>>
BlockUser ..> Friends : <<extend>>
FriendPrefs ..> Friends : <<extend>>
FriendSuggestions ..> Friends : <<extend>>

SendText ..> DirectChat : <<extend>>
SendFile ..> DirectChat : <<extend>>
SendSpecial ..> DirectChat : <<extend>>
ReplyMessage ..> DirectChat : <<extend>>
ReactMessage ..> DirectChat : <<extend>>
MessageActions ..> DirectChat : <<extend>>

SendText ..> GroupChat : <<extend>>
SendFile ..> GroupChat : <<extend>>
SendSpecial ..> GroupChat : <<extend>>
ReplyMessage ..> GroupChat : <<extend>>
ReactMessage ..> GroupChat : <<extend>>
MessageActions ..> GroupChat : <<extend>>

CreateGroup ..> GroupManagement : <<extend>>
JoinGroup ..> GroupManagement : <<extend>>
UpdateGroup ..> GroupManagement : <<extend>>
GroupMembers ..> GroupManagement : <<extend>>
GroupRoles ..> GroupManagement : <<extend>>
LeaveDisbandGroup ..> GroupManagement : <<extend>>

FindUser ..> Search : <<extend>>
FindConversation ..> Search : <<extend>>
FindMessage ..> Search : <<extend>>
FindFile ..> Search : <<extend>>

ViewMedia ..> MediaLibrary : <<extend>>
ViewFiles ..> MediaLibrary : <<extend>>
ViewLinks ..> MediaLibrary : <<extend>>

CreateCall ..> DirectCall : <<extend>>
JoinCall ..> DirectCall : <<extend>>
EndCall ..> DirectCall : <<extend>>
CallControls ..> DirectCall : <<extend>>
ScreenShare ..> DirectCall : <<extend>>

CreateCall ..> GroupCall : <<extend>>
JoinCall ..> GroupCall : <<extend>>
EndCall ..> GroupCall : <<extend>>
CallControls ..> GroupCall : <<extend>>
ScreenShare ..> GroupCall : <<extend>>

CreateAssignment ..> Assignment : <<extend>>
AssignmentDeadline ..> Assignment : <<extend>>
AssignmentRule ..> Assignment : <<extend>>
SubmitAssignment ..> Assignment : <<extend>>
ReplaceSubmission ..> Assignment : <<extend>>
ViewSubmissions ..> Assignment : <<extend>>
AssignmentReminder ..> Assignment : <<extend>>

MessageNotification ..> Notification : <<extend>>
CallNotification ..> Notification : <<extend>>
AssignmentNotification ..> Notification : <<extend>>

LoginAlert ..> SecurityAlerts : <<extend>>
DeviceInfo ..> SecurityAlerts : <<extend>>
LogoutUnknownDevice ..> SecurityAlerts : <<extend>>

OpenAI ..> AIChat : <<extend>>
AskAI ..> AIChat : <<extend>>
SendAIFile ..> AIChat : <<extend>>
AIResponse ..> AIChat : <<include>>

' Hidden links tạo bố cục ngang theo cụm, giống mẫu báo cáo.
Register -[hidden]right- Login
Login -[hidden]right- Account
Account -[hidden]right- Profile
Profile -[hidden]right- Sessions
Sessions -[hidden]right- Settings

Friends -[hidden]right- DirectChat
DirectChat -[hidden]right- GroupChat
GroupChat -[hidden]right- GroupManagement
GroupManagement -[hidden]right- Search
Search -[hidden]right- MediaLibrary

DirectCall -[hidden]right- GroupCall
GroupCall -[hidden]right- Assignment
Assignment -[hidden]right- Notification
Notification -[hidden]right- SecurityAlerts
SecurityAlerts -[hidden]right- AIChat

User -[hidden]right- System
System -[hidden]right- EmailOtp
EmailOtp -[hidden]down- Chime
Chime -[hidden]down- AI

note top of Login
  Các chức năng trong hệ thống yêu cầu người dùng đăng nhập,
  trừ chức năng Đăng ký và Đăng nhập.
end note

note bottom of Assignment
  Bài tập nằm trong chat nhóm.
  Chỉ trưởng nhóm hoặc phó nhóm được giao bài.
end note

@enduml
